<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dignite.Site</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Domain" Version="10.5.0"/>
    <!-- SiteFeatureDefinitionProvider. Volo.Abp.Ddd.Domain does not pull Features in; it only arrives
         transitively at the Application layer. -->
    <PackageReference Include="Volo.Abp.Features" Version="10.5.0"/>
    <!-- IBrandingProvider, replaced tenant-wide by SiteBrandingProvider (总体设计 §4.1) - core ABP
         infrastructure with no ASP.NET Core dependency, not a rendering package, so it does not break the
         "Domain stays library-agnostic" rule the sitemap/robots/feed generators already follow. -->
    <PackageReference Include="Volo.Abp.Ui" Version="10.5.0"/>
    <ProjectReference Include="..\Dignite.Site.Domain.Shared\Dignite.Site.Domain.Shared.csproj" />
    <ProjectReference Include="..\..\..\abp-modules\flex-fields\src\Dignite.Abp.FlexFields.Domain\Dignite.Abp.FlexFields.Domain.csproj" />
    <ProjectReference Include="..\..\..\abp-modules\flex-fields\src\Dignite.Abp.FlexFields.CKEditor\Dignite.Abp.FlexFields.CKEditor.csproj" />
    <!-- The file library's upload pipeline: IFileStorer runs a container's handlers and stores the bytes;
         FileDescriptorManager keeps only the descriptor rows on top of it. A library on ABP BlobStoring,
         not a module with data of its own - the file library itself is Site's (Files/, Directories/). -->
    <ProjectReference Include="..\..\..\abp-modules\file-storing\core\src\Dignite.Abp.FileStoring\Dignite.Abp.FileStoring.csproj" />
    <!-- Content/Seo/file field types (GitHub issue #49) - same bolt-on role as CKEditor above,
         just living in this repo instead of abp-modules. Matrix/Table used to live here too, until
         flex-fields shipped them as kernel built-ins at 10.0.0-rc.16. -->
    <ProjectReference Include="..\Dignite.FlexFields.Site\Dignite.FlexFields.Site.csproj" />
  </ItemGroup>

</Project>
