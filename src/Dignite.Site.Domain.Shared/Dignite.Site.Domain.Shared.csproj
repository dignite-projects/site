<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dignite.Site</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Domain.Shared" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.Validation" Version="10.7.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.12" />
  </ItemGroup>

  <!-- Slug generation (SlugNormalizer). No transliteration package alongside it, deliberately: any
       such table is per-language policy, and this platform has to treat every script alike. See the
       remarks on SlugNormalizer. -->
  <ItemGroup>
    <PackageReference Include="Slugify.Core" Version="5.1.1" />
  </ItemGroup>

  <!-- Scriban, for tenant-authored page templates (SiteTemplate). Here, not in Public.Web, because the
       syntax check at save time (ScribanTemplateSyntax) and the renderer must share one parser, and
       Public.Web may only reference Domain.Shared. -->
  <ItemGroup>
    <PackageReference Include="Scriban" Version="7.2.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\Site\*.json" />
    <Content Remove="Localization\Site\*.json" />
  </ItemGroup>

</Project>
