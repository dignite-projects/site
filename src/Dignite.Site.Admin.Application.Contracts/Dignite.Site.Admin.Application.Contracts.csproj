<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dignite.Site.Admin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Application.Contracts" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.Authorization" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.Features" Version="10.7.0" />
    <ProjectReference Include="..\Dignite.Site.Domain.Shared\Dignite.Site.Domain.Shared.csproj" />
    <ProjectReference Include="..\Dignite.Site.Common.Application.Contracts\Dignite.Site.Common.Application.Contracts.csproj" />
    <!-- FlexFieldQueryCondition (Content list filtering by field value) - a DDD-free, DTO-facing type
         that this project is meant to reference directly (Dignite.Abp.FlexFields.Abstractions' own
         module doc says so); Dignite.Abp.FlexFields.Domain is not referenced here on purpose. -->
    <PackageReference Include="Dignite.Abp.FlexFields.Abstractions" Version="$(DigniteAbpModulesVersion)" />
    <!-- FlexFieldConsts alone, for CreateFieldDto/UpdateFieldDto/RenameFieldDto's [DynamicStringLength] -
         deliberately dependency-free (just Volo.Abp.Core), unlike referencing Dignite.Abp.FlexFields.Domain
         itself would be. -->
    <PackageReference Include="Dignite.Abp.FlexFields.Domain.Shared" Version="$(DigniteAbpModulesVersion)" />
  </ItemGroup>

</Project>
