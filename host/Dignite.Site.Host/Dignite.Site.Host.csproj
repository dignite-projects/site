<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Host is the final application and is not published as a NuGet package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dignite.Site.EntityFrameworkCore\Dignite.Site.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\Dignite.Site.HttpApi\Dignite.Site.HttpApi.csproj" />
    <!-- HttpApi only carries the .Application.Contracts interfaces (explicit controllers, not Auto API
         Controllers - see Admin.HttpApi/Pages/PageAdminController.cs). The concrete app service classes
         still need their own module loaded somewhere for DI to register them; that's here. -->
    <ProjectReference Include="..\..\src\Dignite.Site.Application\Dignite.Site.Application.csproj" />
    <!-- The site-facing documents (robots.txt, sitemap.xml, feeds) and the request-aware base URL
         resolver they depend on. -->
    <ProjectReference Include="..\..\src\Dignite.Site.Public.Web\Dignite.Site.Public.Web.csproj" />
    <!-- The MCP endpoint (GitHub issue #26). -->
    <ProjectReference Include="..\..\src\Dignite.Site.Mcp\Dignite.Site.Mcp.csproj" />
  </ItemGroup>

  <!-- No direct reference to Dignite.FileExplorer here (GitHub issue #41's follow-up): it is part of
       Site, referenced from Dignite.Site.Common.Application(.Contracts)/HttpApi the same way FlexFields
       is, and reaches this Host transitively through Dignite.Site.Application/Dignite.Site.HttpApi. -->

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.11" />
    <PackageReference Include="AspNetCore.HealthChecks.UI" Version="9.0.0" />
    <PackageReference Include="IdentityModel" Version="7.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.InMemory.Storage" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.Autofac" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.Mapperly" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.Swashbuckle" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.AspNetCore.Serilog" Version="10.5.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Account.Web.OpenIddict" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.Account.HttpApi" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.Account.Application" Version="10.5.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.PermissionManagement.Domain.Identity" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.Identity.Web" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.Identity.HttpApi" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.Identity.Application" Version="10.5.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.PermissionManagement.Domain.OpenIddict" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.PermissionManagement.Web" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.PermissionManagement.HttpApi" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.PermissionManagement.Application" Version="10.5.0" />
  </ItemGroup>

  <ItemGroup>   
    <PackageReference Include="Volo.Abp.TenantManagement.Web" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.TenantManagement.HttpApi" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.TenantManagement.Application" Version="10.5.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.FeatureManagement.Web" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.FeatureManagement.HttpApi" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.FeatureManagement.Application" Version="10.5.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.SettingManagement.Web" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.SettingManagement.HttpApi" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.SettingManagement.Application" Version="10.5.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite" Version="5.5.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.AuditLogging.EntityFrameworkCore" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.Identity.EntityFrameworkCore" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.OpenIddict.EntityFrameworkCore" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.TenantManagement.EntityFrameworkCore" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.BackgroundJobs.EntityFrameworkCore" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.BlobStoring.Database.EntityFrameworkCore" Version="10.5.0" />
    <!-- Dev container for Dignite.FileExplorer (GitHub issue #41) - the production provider is still
         undecided, filesystem is what unblocks local dev and #42's field-type wiring in the meantime. -->
    <PackageReference Include="Volo.Abp.BlobStoring.FileSystem" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.FeatureManagement.EntityFrameworkCore" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.PermissionManagement.EntityFrameworkCore" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.SettingManagement.EntityFrameworkCore" Version="10.5.0" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore.Sqlite" Version="10.5.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Studio.Client.AspNetCore" Version="3.0.8" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>compile; contentFiles; build; buildMultitargeting; buildTransitive; analyzers; native</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>compile; contentFiles; build; buildMultitargeting; buildTransitive; analyzers; native</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  
  <ItemGroup Condition="Exists('./openiddict.pfx')">
    <None Remove="openiddict.pfx" />
    <EmbeddedResource Include="openiddict.pfx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Localization\Host\*.json" />
    <EmbeddedResource Include="Localization\Host\*.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Logs\**" />
    <Content Remove="Logs\**" />
    <EmbeddedResource Remove="Logs\**" />
    <None Remove="Logs\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Pages\**\*.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Pages\**\*.css">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Remove="**\*.abppkg" />
    <None Remove="**\*.abppkg.analyze.json" />
    <Content Remove="$(UserProfile)\.nuget\packages\*\*\contentFiles\any\*\*.abppkg*" />
  </ItemGroup>



</Project>
