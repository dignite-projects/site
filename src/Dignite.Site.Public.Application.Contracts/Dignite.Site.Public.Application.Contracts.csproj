<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dignite.Site.Public</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Application.Contracts" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.Authorization" Version="10.7.0" />
    <!-- IClock.Normalize - ClockExtensions.ToOffset, shared with Dignite.Site.Public.Web (which cannot
         reference Dignite.Site.Domain, where the equivalent Seo.SeoClock.ToOffset lives). -->
    <PackageReference Include="Volo.Abp.Timing" Version="10.7.0" />
    <ProjectReference Include="..\Dignite.Site.Domain.Shared\Dignite.Site.Domain.Shared.csproj" />
    <ProjectReference Include="..\Dignite.Site.Common.Application.Contracts\Dignite.Site.Common.Application.Contracts.csproj" />
    <!-- FlexFieldQueryCondition (Content list filtering by field value) - see the matching comment in
         Dignite.Site.Admin.Application.Contracts.csproj. -->
    <PackageReference Include="Dignite.Abp.FlexFields.Abstractions" Version="$(DigniteAbpModulesVersion)" />
  </ItemGroup>

</Project>
