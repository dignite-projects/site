{
  "packages":[
    {
      "appRoutingModuleConfiguration":{
        "imports":[
          {
            "names":[
              "SITES_ROUTES"
            ],
            "namespace": "@dignite/sites"
          } 
        ],
        "routes":[
          "{ path: 'sites', children: SITES_ROUTES, canActivate: [authGuard] }"
        ]
      },
      "appModuleConfiguration":{
        "imports":[
          {
            "names":[
              "provideSites"
            ],
            "namespace": "@dignite/sites/config"
          }
        ],
        "providerNames":[
          "provideSites()"
        ]
      },
      "tsJsonPathRecordConfigurations":[
        {
          "name": "@dignite/sites",
          "paths": [
            "angular/projects/sites/src/public-api.ts"
          ]
        },
        {
          "name": "@dignite/sites/config",
          "paths": [
            "angular/projects/sites/config/src/public-api.ts"
          ]
        }
      ]
    }
  ]
}