# @swimlane/ngx-datatable@22.0.0 (the version @abp/ng.theme.shared@10.5.0 actually depends on)
# declares a peer range of @angular/common "18.x || 19.x || 20.x", which doesn't include 21.x.
# The working reference project (abp-modules/notifications/angular) installs the same
# ngx-datatable 22.0.0 + Angular 21.2 combination successfully via yarn (which doesn't hard-fail
# on peer mismatches); this setting reproduces that with npm. Without it, `npm install` fails
# with ERESOLVE.
legacy-peer-deps=true
