/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "../../tsconfig.prod.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": [],
    // es2022 to match the `target` in tsconfig.prod.json. The scaffold's es2018 left out Array.flatMap
    // and friends, which the runtime has had for years.
    "lib": ["dom", "es2022"]
  },
  "exclude": ["src/test.ts", "**/*.spec.ts"]
}
