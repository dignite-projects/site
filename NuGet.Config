<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Local only, until Dignite Drive is published: abp-modules packed as 10.7.7-local.N into a folder beside the
         repositories (dev-docs/drive-integration-plan.md, step 2). Revert this file before the branch is pushed. -->
    <add key="dignite-local" value="../_local-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.*" />
      <package pattern="Volo.*" />
      <package pattern="Dignite.*" />
    </packageSource>
    <packageSource key="dignite-local">
      <package pattern="Dignite.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
