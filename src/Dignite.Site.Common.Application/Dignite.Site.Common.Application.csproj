    <ProjectReference Include="..\Dignite.Site.Common.Application.Contracts\Dignite.Site.Common.Application.Contracts.csproj" />
    <ProjectReference Include="..\Dignite.Site.Domain\Dignite.Site.Domain.csproj" />
  </ItemGroup>

</Project>
