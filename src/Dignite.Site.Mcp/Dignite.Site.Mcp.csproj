<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dignite.Site.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The official C# MCP SDK. Apache-2.0, targets net10.0 natively, and its only transitive
         dependencies are Microsoft.Extensions.AI.Abstractions and Logging.Abstractions - nothing that
         collides with ABP (总体设计 §8.4). -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.1.0" />
    <!-- For AbpEndpointRouterOptions (how the /mcp endpoint is mapped without the module having to run
         its own middleware) and IExceptionToErrorInfoConverter (how tool errors are structured). -->
    <PackageReference Include="Volo.Abp.AspNetCore" Version="10.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The unified contracts: MCP tools call the Admin app services (they must see drafts) plus the
         Public routing service. They never reach past this into Domain - 总体设计 §6.2.2. -->
    <ProjectReference Include="..\Dignite.Site.Application.Contracts\Dignite.Site.Application.Contracts.csproj" />
  </ItemGroup>

</Project>
