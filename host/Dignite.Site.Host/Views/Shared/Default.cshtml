@model SiteRenderViewModel
@{
    // Overrides any Layout an outer _ViewStart.cshtml assigns - ABP's theme contributes one that reaches
    // across the merged virtual file system into every module's Views, this one included, which would
    // otherwise nest this whole document inside the host app's own <body> instead of controlling the page.
    Layout = null;
}
<!DOCTYPE html>
<html lang="@Model.CultureName">
<head>
    <meta charset="utf-8" />
    <title>@(Model.HeadMetadata?.MetaTitle ?? Model.Page.DisplayName)</title>
    @if (Model.HeadMetadata?.MetaDescription is { } description)
    {
        <meta name="description" content="@description" />
    }
</head>
<body>
@if (Model.Content != null)
{
    <h1>@Model.Page.DisplayName</h1>
    <p>@Model.Content.Content.PublishTime</p>
    <hr />
    @foreach (var field in Model.Content.Fields)
    {
        <flex-field-view field="@field" />
    }
}
else
{
    <h1>@Model.Page.DisplayName</h1>
    <content-list page="@Model.Page" culture-name="@Model.CultureName" field-filters="@Model.FieldFilters"
                  published-after="@Model.PublishedAfter" published-before="@Model.PublishedBefore"
                  partial-name="_ContentListDefault" />
}
</body>
</html>
