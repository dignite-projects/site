<Project>
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <!-- 0.y.z: not stable yet. Pre-release (-preview.N) builds publish to GitHub Packages only;
             dropping the suffix is what promotes a build to NuGet.org - see release.yml. -->
        <Version>0.1.0-preview.2</Version>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <NuGetAudit>false</NuGetAudit>
        <AbpProjectType>module</AbpProjectType>
    </PropertyGroup>

    <PropertyGroup Label="NuGet package metadata">
        <Authors>Dignite</Authors>
        <Company>Dignite</Company>
        <Product>Dignite Site</Product>
        <Copyright>© Dignite</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/dignite-projects/site</PackageProjectUrl>
        <RepositoryUrl>https://github.com/dignite-projects/site</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>abp;cms;mcp;multi-tenant;site</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <!-- Package the repository root README.md. For IsPackable=false projects (host / test, see
         common.test.props), this is only a non-compiling None item and has no side effects. -->
    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false"/>
    </ItemGroup>

    <!-- Source Link + embedded symbols, so consumers can step into the exact source that built a
         package. ContinuousIntegrationBuild is gated on GITHUB_ACTIONS so local builds keep real,
         debuggable local paths. PDBs are embedded rather than shipped as a separate .snupkg, the
         same choice vault-extract's common.props documents (Fody strips a debug-directory entry
         that trips NuGet.org's .snupkg checksum validation). -->
    <PropertyGroup Label="Source Link / embedded symbols">
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <DebugType>embedded</DebugType>
        <IncludeSymbols>false</IncludeSymbols>
    </PropertyGroup>

    <ItemGroup Label="Source Link / symbol packages">
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ConfigureAwait.Fody" Version="3.3.1" PrivateAssets="All"/>
        <PackageReference Include="Fody" Version="6.5.3">
            <PrivateAssets>All</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <Target Name="NoWarnOnRazorViewImportedTypeConflicts" BeforeTargets="RazorCoreCompile">
        <PropertyGroup>
            <NoWarn>$(NoWarn);0436</NoWarn>
        </PropertyGroup>
    </Target>

    <ItemGroup>
        <None Remove="**\*.abppkg"/>
        <None Remove="**\*.abppkg.analyze.json"/>
        <Content Remove="$(UserProfile)\.nuget\packages\*\*\contentFiles\any\*\*.abppkg*"/>
    </ItemGroup>

</Project>