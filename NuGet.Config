<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Dignite Blob Management is on GitHub Packages only (abp-modules' pre-release channel, 10.7.7-preview.N; it is
         promoted to NuGet.org by dropping the suffix), and so is every abp-modules package at that lockstep version.
         Reading GitHub Packages requires auth even to read: set the environment variable GITHUB_PACKAGES_TOKEN to a PAT
         with the read:packages scope (ci.yml passes secrets.PACKAGES_READ_TOKEN). Revert this source, the credentials
         and the version in common.props when Blob Management is on NuGet.org. -->
    <add key="github-dignite-projects" value="https://nuget.pkg.github.com/dignite-projects/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github-dignite-projects>
      <add key="Username" value="dignite-projects" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github-dignite-projects>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.*" />
      <package pattern="Volo.*" />
      <package pattern="Dignite.*" />
    </packageSource>
    <packageSource key="github-dignite-projects">
      <package pattern="Dignite.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
