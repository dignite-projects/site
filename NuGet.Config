<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Dignite Blob Management 10.7.7-preview.1 is on GitHub Packages only (abp-modules' pre-release channel; it is
         promoted to NuGet.org by dropping the suffix). Reading it takes a token with read:packages, under this key, in
         the user-level NuGet.Config. Revert this source and the version in common.props when Blob Management is on
         NuGet.org, and before the branch is pushed: a CI run has no such token. -->
    <add key="github-dignite-projects" value="https://nuget.pkg.github.com/dignite-projects/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.*" />
      <package pattern="Volo.*" />
      <package pattern="Dignite.*" />
    </packageSource>
    <packageSource key="github-dignite-projects">
      <package pattern="Dignite.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
