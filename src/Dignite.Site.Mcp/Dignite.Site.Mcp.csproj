<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dignite.Site.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The unified contracts: MCP tools call the Admin app services (they must see drafts) plus the
         Public routing service. They never reach past this into Domain - 总体设计 §6.2.2. -->
    <ProjectReference Include="..\Dignite.Site.Application.Contracts\Dignite.Site.Application.Contracts.csproj" />
    <!-- The application's one MCP server - transport, endpoint, permission filtering, the error envelope,
         startup checks - which this project only contributes tools to (under the "site" namespace). It
         also brings the official C# MCP SDK (ModelContextProtocol.AspNetCore, Apache-2.0, 总体设计 §8.4),
         pinned in abp-modules' Directory.Packages.props so every module on one server agrees on a version. -->
    <ProjectReference Include="..\..\..\abp-modules\aspnetcore-mcp\src\Dignite.Abp.AspNetCore.Mcp\Dignite.Abp.AspNetCore.Mcp.csproj" />
  </ItemGroup>

</Project>
